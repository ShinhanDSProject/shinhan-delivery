<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- Wildcard Import 방지 (code-convention.md §8) -->
  <module name="TreeWalker">
    <module name="AvoidStarImport"/>

    <!-- 식별자 명명 규칙 린팅 (code-convention.md §8.1) -->
    
    <!-- 1. 메서드명: 무조건 lowerCamelCase (언더스코어 및 한글 금지) -->
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern"
               value="메서드 명 ''{0}''은(는) 무조건 lowerCamelCase 규칙을 준수해야 합니다. (언더스코어 및 한글 사용 금지)"/>
    </module>

    <!-- 2. 상수명: static final 상수는 UPPER_SNAKE_CASE (log, serialVersionUID 제외) -->
    <module name="ConstantName">
      <property name="format" value="^([A-Z][A-Z0-9]*(_[A-Z0-9]+)*|log|serialVersionUID)$"/>
      <message key="name.invalidPattern"
               value="상수 명 ''{0}''은(는) 무조건 UPPER_SNAKE_CASE 규칙을 준수해야 합니다."/>
    </module>

    <!-- 3. 클래스 및 인터페이스명: UpperCamelCase (PascalCase) -->
    <module name="TypeName">
      <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern"
               value="클래스/인터페이스 명 ''{0}''은(는) UpperCamelCase(PascalCase) 규칙을 준수해야 합니다."/>
    </module>

    <!-- 4. 변수 및 필드명: lowerCamelCase -->
    <module name="MemberName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="LocalVariableName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="ParameterName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

  </module>
</module>
