#!/usr/bin/env bash
# 원클릭 자동 검증 및 PR 생성 스크립트 (./pr)
set -e

BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
RESET="\033[0m"

echo -e "${BLUE}🚀 [1/3] 로컬 검증(Verify) 실행 중...${RESET}"
bash scripts/verify.sh

CURRENT_BRANCH=$(git branch --show-current)
if [ "$CURRENT_BRANCH" = "main" ]; then
    NEW_BRANCH="feat/auto-pr-$(date +%Y%m%d%H%M%S)"
    echo -e "${BLUE}📌 main 브랜치 감지 -> 새 작업 브랜치 생성: $NEW_BRANCH${RESET}"
    git checkout -b "$NEW_BRANCH"
    CURRENT_BRANCH="$NEW_BRANCH"
fi

echo -e "\n${BLUE}🚀 [2/3] 변경사항 커밋 & Remote 푸시...${RESET}"
git add .
MSG="feat: 자동 검증 및 변경사항 작업 반영 ($(date +'%Y-%m-%d %H:%M'))"
git commit -m "$MSG" || true
git push -u origin "$CURRENT_BRANCH"

echo -e "\n${BLUE}🚀 [3/3] GitHub PR 확인 및 생성...${RESET}"
# 이미 PR이 존재하는지 확인
EXISTING_PR=$(gh pr view "$CURRENT_BRANCH" --json url -q .url 2>/dev/null || true)

if [ -n "$EXISTING_PR" ]; then
    PR_URL="$EXISTING_PR"
    echo -e "${GREEN}📌 기존에 생성된 PR을 업데이트했습니다!${RESET}"
else
    PR_URL=$(gh pr create --title "$MSG" --body "자동 검증 및 반영 완료 (\`./pr\` 스크립트 구동)" 2>&1 || true)
    if [[ "$PR_URL" =~ "http" ]]; then
        echo -e "${GREEN}📌 새 PR이 성공적으로 생성되었습니다!${RESET}"
    fi
fi

echo -e "\n${GREEN}======================================================"${RESET}
echo -e "${GREEN} 🎉 작업 완료! PR 링크:${RESET}"
echo -e "${BOLD}${GREEN} $PR_URL${RESET}"
echo -e "${GREEN}======================================================"${RESET}
