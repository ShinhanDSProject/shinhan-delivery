# ==============================================================================
# shinhan-delivery 로컬 환경 변수 샘플 (.env.sample)
# ------------------------------------------------------------------------------
# 사용법: 이 파일을 .env 로 복사한 뒤 내 로컬 환경에 맞게 값을 채우세요.
#
#   cp .env.sample .env        # macOS / Linux
#   copy .env.sample .env      # Windows (cmd)
#
# .env 는 .gitignore에 등록되어 Git에 커밋되지 않습니다. 실제 비밀번호는 .env 에만
# 적고, 이 샘플 파일에는 절대 실제 값을 채워 넣지 마세요.
#
# 값을 비워 두거나 키를 지우면 application.yaml에 정의된 기본값이 적용됩니다.
# (기본값은 각 항목의 주석에 적어 두었습니다)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 데이터베이스 연결 (필수)
# ------------------------------------------------------------------------------
# 기본값은 H2 인메모리 DB라 값을 채우지 않아도 기동은 되지만, 앱을 끄면 데이터가
# 모두 사라집니다. 로컬 MariaDB를 쓰려면 아래 4개를 반드시 채우세요.

# 접속 URL (기본값: jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;MODE=MySQL)
DB_URL=jdbc:mariadb://localhost:3306/shinhan_delivery

# DB 계정 (기본값: sa)
DB_USER=root

# DB 비밀번호 (기본값: 빈 값) — 실제 비밀번호는 .env 에만 적습니다
DB_PASSWORD=your_password_here

# JDBC 드라이버 (기본값: org.h2.Driver)
DB_DRIVER=org.mariadb.jdbc.Driver

# DB가 아직 뜨는 중이어도 앱이 곧바로 죽지 않고 연결될 때까지 기다리는 재시도 설정입니다.
# Flyway가 DataSource를 가장 먼저 잡기 때문에, 이 값이 앱 전체의 DB 대기 시간을 결정합니다.
# 기본값 10회 x 최대 5초면 약 45초까지 기다린 뒤 실패합니다.
# 반대로 DB_URL 오타 같은 진짜 설정 오류도 그만큼 늦게 알게 되니, 빠른 실패를 원하면 0으로 두세요.
FLYWAY_CONNECT_RETRIES=10
FLYWAY_CONNECT_RETRIES_INTERVAL=5

# ------------------------------------------------------------------------------
# 2. 로컬 더미 데이터 자동 적재
# ------------------------------------------------------------------------------
# true 로 두면 기동 시 DataSeedInitializer가 관리자·회원·지갑·차량·배송 1건을
# 자동으로 넣어 줍니다. 단, 이미 회원이 2명 이상이면 건너뜁니다.
# 배송 전 상태(매칭/픽업/완료/취소)를 한 번에 보고 싶다면 아래 SQL을 쓰세요.
#   mariadb -u <계정> -p <DB명> < scripts/sql/dummy-data.sql
# 자세한 내용: scripts/sql/README.md
DATA_SEED_ENABLED=true

# ------------------------------------------------------------------------------
# 3. 배송 자동 타임아웃 스케줄러 (선택)
# ------------------------------------------------------------------------------
# 배송원이 배정되지 않은 요청을 자동 취소·환불하는 배치입니다.
# 로컬에서 로그가 시끄럽거나 데이터가 자동으로 취소되는 게 불편하면 false로 끄세요.

# 스케줄러 사용 여부 (기본값: true)
DELIVERY_TIMEOUT_ENABLED=true

# 이 시간(분)을 넘도록 매칭되지 않은 요청을 자동 취소 (기본값: 30)
DELIVERY_TIMEOUT_MINUTES=30

# 배치 실행 주기 (밀리초, 기본값: 60000 = 1분)
DELIVERY_TIMEOUT_FIXED_DELAY_MS=60000

# 한 번에 처리할 최대 건수 (기본값: 100)
DELIVERY_TIMEOUT_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# 4. 파일 업로드 (선택)
# ------------------------------------------------------------------------------
# 배송 인증 사진 등이 저장될 로컬 디렉터리 (기본값: uploads)
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 5. Spring Boot 표준 환경 변수 (선택 — 필요할 때만 주석 해제)
# ------------------------------------------------------------------------------
# 8080 포트가 이미 사용 중일 때 다른 포트로 기동 (기본값: 8080)
# SERVER_PORT=8080

# Flyway 마이그레이션 사용 여부 (기본값: true)
# 특별한 이유가 없으면 끄지 마세요. 끄면 아래 FLYWAY_CONNECT_RETRIES도 함께 무력화되고,
# Hibernate(ddl-auto: validate)가 기동 시점에 커넥션을 요구해 그대로 실패합니다.
# SPRING_FLYWAY_ENABLED=true
